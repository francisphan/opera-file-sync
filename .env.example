# Salesforce OAuth Credentials
SF_INSTANCE_URL=https://YOUR_INSTANCE.my.salesforce.com
SF_CLIENT_ID=YOUR_CLIENT_ID_HERE
SF_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
SF_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE

# Salesforce Object Configuration
SF_OBJECT=TVRS_Guest__c
SF_EXTERNAL_ID_FIELD=Email__c

# Sync Configuration
SYNC_MODE=upsert
# upsert = create or update based on external ID
# insert = only create new records

# Logging
LOG_LEVEL=warn
# Levels: error, warn (default), info, debug

# Processing Options
BATCH_SIZE=200
# Number of records to send to Salesforce in each batch

# ===================================================================
# Email Notifications (Gmail OAuth2)
# ===================================================================

# Enable/disable email notifications
EMAIL_ENABLED=true

# Gmail OAuth2 (recommended - run: node get-gmail-oauth-token.js)
SMTP_USER=your-email@gmail.com
GMAIL_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_GMAIL_REFRESH_TOKEN

# Email Addresses
EMAIL_FROM=OPERA Sync <your-email@gmail.com>
EMAIL_TO=admin@yourcompany.com
# Comma-separated for multiple recipients: admin@company.com,it@company.com

# Notification Settings
ERROR_THRESHOLD=3
# Number of consecutive errors before sending notification

ERROR_NOTIFICATION_THROTTLE=15
# Minutes to wait before sending another error notification (prevents spam)

# ===================================================================
# Alternative: Standard SMTP (if not using Gmail OAuth)
# ===================================================================
# If GMAIL_CLIENT_ID is not set, the notifier falls back to SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE

# ===================================================================
# Slack Notifications (Optional - alternative to email)
# ===================================================================

# Slack Webhook URL (leave empty to disable)
SLACK_WEBHOOK_URL=
# Create webhook at: https://api.slack.com/messaging/webhooks

# ===================================================================
# OPERA Oracle Database (for direct queries)
# ===================================================================
ORACLE_HOST=YOUR_ORACLE_HOST
ORACLE_PORT=1521
# Use ORACLE_SID for SID-based connections, or ORACLE_SERVICE for service name
ORACLE_SID=OPERA
# ORACLE_SERVICE=
ORACLE_USER=YOUR_USERNAME
ORACLE_PASSWORD=YOUR_PASSWORD

# ===================================================================
# Duplicate Detection
# ===================================================================

# Enable/disable duplicate detection
ENABLE_DUPLICATE_DETECTION=true

# Probability threshold for skipping duplicates (0-100)
# Records with probability >= threshold will be skipped and reported
DUPLICATE_THRESHOLD=75

# Cache TTL for Salesforce records (ms)
# How long to keep the SF cache before refreshing (default: 1 hour)
DUPLICATE_CACHE_TTL=3600000

# ===================================================================
# Daily Summary Reports
# ===================================================================

# Enable/disable daily summary emails
ENABLE_DAILY_SUMMARY=true

# Time to send daily summary (24-hour format)
DAILY_SUMMARY_TIME=9:00

# Timezone for daily summary scheduling
# Use IANA timezone format (e.g., America/Argentina/Buenos_Aires)
DAILY_SUMMARY_TIMEZONE=America/Argentina/Buenos_Aires

# ===================================================================
# Front Desk Email Report
# ===================================================================

# Email address(es) for front desk staff (on-property guests needing email collection)
FRONT_DESK_EMAIL_TO=frontdesk@yourcompany.com

# Time to send front desk report (defaults to DAILY_SUMMARY_TIME or 7:00)
FRONT_DESK_EMAIL_TIME=7:00

# Enable/disable front desk report (defaults to true when FRONT_DESK_EMAIL_TO is set)
ENABLE_FRONT_DESK_REPORT=true

# Recipient for the separate data-quality report (guests missing a valid email,
# date of birth, phone, or passport). Defaults to foh@vinesresortandspa.com.
FRONT_DESK_DATA_EMAIL_TO=foh@vinesresortandspa.com

# Optional CC on the data-quality report (comma-separated for multiple).
FRONT_DESK_DATA_EMAIL_CC=

# The profile note categories shown in the report's Notes column are fixed in
# code (FRONT_DESK_NOTE_CODES in src/opera-db-query.js) — HISTORY (PVO
# Information), PALBE (Preferencias Alimentos y Bebidas), PREF (Preferencias).
# Inspect the property's note codes with:
#   node scripts/dry-run-front-desk-report.js --discover

# ===================================================================
# Villa Nights Report (bi-weekly)
# ===================================================================

# Recipient(s) for the nights-per-villa report (comp vs paid + rate-code breakdown).
# Leave unset to disable the recurring report.
VILLA_REPORT_EMAIL_TO=owner@yourcompany.com

# Day of week to fire (0=Sunday … 6=Saturday; default 1 = Monday). Runs every
# OTHER week on this day, covering the prior 14 nights.
VILLA_REPORT_DOW=1

# Time of day to send (defaults to 8:00 in DAILY_SUMMARY_TIMEZONE)
VILLA_REPORT_TIME=8:00

# Enable/disable (defaults to true when VILLA_REPORT_EMAIL_TO is set)
ENABLE_VILLA_REPORT=true

# ===================================================================
# Email Exclusions
# ===================================================================

# Comma-separated list of email domains to exclude (staff/internal)
EXCLUDED_EMAIL_DOMAINS=yourdomain.com,otherdomain.com

# Comma-separated list of specific email addresses to exclude
EXCLUDED_EMAILS=someone@example.com

# ===================================================================
# Kill Switch
# ===================================================================

# Andon cord — set to 'true' to pause ALL Salesforce activity without stopping the process.
# Skips the startup SF connection test (no error email, no crash-loop) and skips each poll's
# SF write while holding the sync watermark, so the backlog replays to SF once unset + restarted.
# Oracle polling, front desk reports, daily summary, and Google Sheets sync keep running.
# ANDON_CORD=true

# ===================================================================
# Feature Flags
# ===================================================================

# Sync phone number from Oracle DB to Salesforce Telephone__c field
SYNC_PHONE_FIELD=true

# Sync language preference from Oracle DB to Salesforce Language__c field
SYNC_LANGUAGE_FIELD=true

# ===================================================================
# Google Sheets — Guest Checkout Survey
# ===================================================================

# Enable auto-populating the checkout survey Google Sheet
GOOGLE_SHEETS_ENABLED=false

# Spreadsheet ID (from the Google Sheets URL)
GOOGLE_SHEETS_ID=YOUR_SPREADSHEET_ID

# ===================================================================
# Google Sheets — Check-in Arrivals Tracking
# ===================================================================

# Enable auto-populating daily arrivals for tasting conversion tracking
# Creates monthly tabs (e.g., "Check-ins Marzo 2026") in the target spreadsheet
GOOGLE_SHEETS_CHECKIN_ENABLED=false

# Spreadsheet ID for the Sales tracking sheet (must be shared with OAuth account)
GOOGLE_SHEETS_CHECKIN_ID=YOUR_SPREADSHEET_ID

# ===================================================================
# Villa Number Map (OPERA # → physical signage #)
# ===================================================================
# OPERA was renumbered in place; the front-desk report shows the physical
# number with the OPERA number alongside, e.g. "17 (OPERA 025)". The mapping
# is cached locally (villa-map.json, with a built-in seed) and refreshed weekly
# from the "Cambio de Numeracion" sheet (reuses the GMAIL_* OAuth credentials).

# Spreadsheet ID of the renumbering sheet (defaults to the known sheet if unset)
# VILLA_MAP_SHEET_ID=188F7zx8YXxBJTmO9Hxx_F_58tfrnY82GtZzvLFLGalE

# Weekly refresh schedule (defaults: Sunday 03:00 in DAILY_SUMMARY_TIMEZONE)
# VILLA_MAP_REFRESH_ENABLED=true
# VILLA_MAP_REFRESH_DOW=0          # 0 = Sunday … 6 = Saturday
# VILLA_MAP_REFRESH_TIME=3:00
